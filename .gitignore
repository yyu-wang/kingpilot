# ══════════════════════════════════════════════════════════════
# .gitignore —— KingPilot 企业级 Agent 项目
# 原则：凭证/密钥绝不上库；本地数据与缓存不入库；只提交源码与配置模板
# ══════════════════════════════════════════════════════════════

# ── Python 编译产物 ──
__pycache__/
*.py[cod]
*$py.class
*.so

# ── 打包与分发 ──
build/
dist/
*.egg-info/
.eggs/

# ── 虚拟环境 ──
.venv/
venv/
env/
ENV/

# ── 测试与静态检查缓存 ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── 环境与密钥（安全红线：绝不入库）──
.env
.env.*
!.env.example

# ── 本地运行数据（溯源账本 / 死信队列 / 缓存库）──
data/
*.db
*.sqlite
*.sqlite3
logs/
*.log

# ── 编辑器与操作系统 ──
.idea/
.vscode/
.DS_Store
