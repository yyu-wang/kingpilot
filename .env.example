# ══════════════════════════════════════════════════════════════════════════
# KingPilot 环境变量模板（M0-T04）
#
# 使用：cp .env.example .env，然后填入真实值。
# 红线：.env 已被 .gitignore 忽略，真实密钥永不入库。
#
# 加载优先级：init 入参 > 环境变量 > .env > 默认值
# 注意：未识别的 KINGPILOT_* 环境变量会被静默忽略（pydantic-settings 原生行为）。
# ══════════════════════════════════════════════════════════════════════════

# ── 运行时环境分层 ──
# dev / test / prod
KINGPILOT_ENV=dev

# DEBUG / INFO / WARNING / ERROR / CRITICAL
KINGPILOT_LOG_LEVEL=INFO

# ── ERP 适配层（厂商选择）──
# kingdee（默认，已实现）/ yonyou（骨架，仅演示扩展方式）
KINGPILOT_ERP_VENDOR=kingdee

# ── 金蝶云星空（沙箱）──
# 服务器地址，如 https://xxx.ik3cloud.com
KINGPILOT_KINGDEE_SERVER_URL=
# 账套 ID
KINGPILOT_KINGDEE_ACCT_ID=
# 登录用户名
KINGPILOT_KINGDEE_USER=
# 应用 ID（第三方应用授权）
KINGPILOT_KINGDEE_APP_ID=
# 应用密钥（永不入日志、永不入库）
KINGPILOT_KINGDEE_APP_SECRET=

# ── 金蝶客户端调优 ──
# 单次请求超时（秒）
KINGPILOT_KINGDEE_TIMEOUT_SECONDS=10
# 最大并发
KINGPILOT_KINGDEE_MAX_CONCURRENCY=5
# 失败重试次数
KINGPILOT_KINGDEE_MAX_RETRIES=3

# ── LLM（M2-T02：DeepSeek，OpenAI 兼容协议）──
# 路由逻辑名（对应 config/model_registry.py 的键）
# - chat_default / 空：自动按下方 LLM_TIER 走 ROUTING_CONFIG（M7-T03）
# - 其他逻辑名：显式覆盖，固定单路由并忽略档位
# 本地开发可切 Ollama：KINGPILOT_LLM_ROUTE=ollama_qwen（详见 model_registry.py 注释）
KINGPILOT_LLM_ROUTE=chat_default
# 模型档位（M7-T03）：high / mid / economy，仅自动路由时生效
# 预算超限时由 T04 自动降档：high → mid → economy
KINGPILOT_LLM_TIER=high
# DeepSeek API Key（platform.deepseek.com 创建，永不入库）
# 切 Ollama 时填任意占位串（如 ollama）——Ollama 不鉴权，但空值会触发 fail-fast
KINGPILOT_LLM_API_KEY=
# 采样温度（0~2，默认 0=贪心解码：查询与评测都要求确定性输出）
KINGPILOT_LLM_TEMPERATURE=0

# ── HTTP API 认证（M9-T01）──
# 只存 SHA-256 哈希，不存明文 key。生成方式：
#   printf 'your-dev-key' | shasum -a 256 | awk '{print $1}'
# 格式（M9-T11 起 tenant_id 必填）：
# {"<64位小写hash>": {"user_id": "alice", "tenant_id": "default", "role": "viewer", "data_scope": {}}}
# 空值 = 所有 API 请求 401（安全默认）
KINGPILOT_API_KEY_HASHES='{}'

# ── RAG 知识库（M9-T08）──
# 知识源目录（按一级目录名分级：public/ internal/ sensitive/ high_sensitive/）
# KINGPILOT_RAG_SOURCE_DIR=~/.kingpilot/knowledge
# 索引目录（index.json，0600）
# KINGPILOT_RAG_INDEX_DIR=~/.kingpilot/rag_index

# ── 密钥来源（M9-T10）──
# env（默认，兼容现有 .env）/ file / vault
KINGPILOT_SECRET_PROVIDER=env
# 文件/Vault 密钥缓存 TTL（秒）
KINGPILOT_SECRET_CACHE_TTL_SECONDS=60
# file 模式：JSON 文件，权限必须 0600
# KINGPILOT_SECRET_FILE_PATH=~/.kingpilot/secrets.json
# vault 模式：KV v2（GET /v1/{mount}/data/{path}），token 永不入日志
# KINGPILOT_VAULT_URL=https://vault.example.com
# KINGPILOT_VAULT_TOKEN=
# KINGPILOT_VAULT_MOUNT=secret
# KINGPILOT_VAULT_PATH=kingpilot
# KINGPILOT_VAULT_TIMEOUT_SECONDS=3
# Vault 不可用时是否回退 env（默认 false = 直接失败）
KINGPILOT_VAULT_ALLOW_FALLBACK=false
